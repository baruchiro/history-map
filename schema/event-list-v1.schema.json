{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-list contribution v1",
  "description": "One list per file. Compiler additionally checks IDs, URL credentials and final UTF-8 size.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lists"
  ],
  "properties": {
    "lists": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "kind",
          "events"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "historical",
              "tradition",
              "fiction"
            ]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year",
                "title",
                "place",
                "lat",
                "lon",
                "text",
                "source",
                "publisher"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": -5000,
                  "maximum": 2100,
                  "not": {
                    "const": 0
                  }
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "place": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "source": {
                  "type": "string",
                  "maxLength": 2000,
                  "pattern": "^https://"
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "date": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "uncertainty": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    }
  }
}
