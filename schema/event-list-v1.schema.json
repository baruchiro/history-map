{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-list contribution v1",
  "description": "One list per file. Compiler additionally checks IDs, URL credentials and final UTF-8 size.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lists"
  ],
  "properties": {
    "lists": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "kind",
          "events"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "historical",
              "tradition",
              "fiction"
            ]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year",
                "title",
                "place",
                "lat",
                "lon",
                "source",
                "publisher"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": -5000,
                  "maximum": 2100,
                  "not": {
                    "const": 0
                  }
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12,
                  "description": "Optional month (1-12) of the event, or of a span's first year. Only for common-era years. When a timeline's events span three years or less and at least one has a month, the map shows a month-by-month timeline."
                },
                "endYear": {
                  "type": "integer",
                  "minimum": -5000,
                  "maximum": 2100,
                  "not": {
                    "const": 0
                  },
                  "description": "Optional last year of a span record. Must be later than year. Omit for a single-year point event. The compiler enforces endYear > year."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "place": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "source": {
                  "type": "string",
                  "maxLength": 2000,
                  "pattern": "^https://"
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "date": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "uncertainty": {
                  "type": "string",
                  "maxLength": 1000
                },
                "wikipedia": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "language",
                    "pageId"
                  ],
                  "properties": {
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}$"
                    },
                    "pageId": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "wikipedia"
                  ]
                }
              ]
            }
          },
          "work": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "url"
            ],
            "description": "Optional source work (series, film, book) that the list is built around.",
            "properties": {
              "type": {
                "enum": [
                  "series",
                  "film",
                  "book"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 2100
              },
              "url": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  }
}
